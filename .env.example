# "Start your project" form → emails each enquiry to Geetha (src/app/api/enquiry/route.ts).
# Copy to .env.local for local testing, and add the same values in your host's environment settings.
#
# GMAIL_APP_PASSWORD is a 16-character Google "App password", NOT your normal Gmail password:
#   Google Account → Security → 2-Step Verification (turn on) → App passwords → create one for "Portfolio".
GMAIL_USER=geethakrishna.designer@gmail.com
GMAIL_APP_PASSWORD=
# Optional: deliver enquiries to a different inbox (defaults to geethakrishna.designer@gmail.com)
# ENQUIRY_TO=

# Search engines: paste the verification codes they give you (only the code, not the whole <meta> tag).
# Google Search Console -> Add property -> URL prefix -> "HTML tag" method
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> Add site -> "HTML Meta Tag" method (or import from Google Search Console)
BING_SITE_VERIFICATION=
# Yandex Webmaster (optional)
YANDEX_SITE_VERIFICATION=

# Your live domain, e.g. https://geethakrishna.com (used for canonical URLs, sitemap and `npm run seo:ping`)
NEXT_PUBLIC_SITE_URL=
